<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit %}
          {% assign homepage_news_window = site.announcements.homepage_max_age_days | times: 86400 %}
          {% assign current_time = site.time | date: '%s' | plus: 0 %}
          {% assign homepage_news_cutoff = current_time | minus: homepage_news_window %}
        {% endif %}
        {% for item in news %}
          {% assign show_item = true %}
          {% if include.limit %}
            {% assign item_time = item.date | date: '%s' | plus: 0 %}
            {% if item_time < homepage_news_cutoff %}
              {% assign show_item = false %}
            {% endif %}
          {% endif %}
          {% if show_item %}
            <tr>
              <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
              <td>
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {% endif %}
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
